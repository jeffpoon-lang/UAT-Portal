<% subtitle = capture do %>
  <span class="inline-flex flex-wrap items-center gap-x-2 gap-y-1">
    <%= round_status_badge(@round, :admin) %>
    <span>開咗 <%= local_time(@round.opened_at) %></span>
    <% if @round.sign_off %>· <%= link_to @round.sign_off.doc_number, admin_sign_off_path(@round.sign_off), class: "link" %><% end %>
  </span>
<% end %>
<% content_for :title, "Round #{@round.number} · #{@project.name}" %>
<%= page_header "UAT Round #{@round.number}／#{@project.allowed_uat_rounds}", subtitle: subtitle,
      crumbs: [ [ "Projects", admin_projects_path ], [ @project.name, admin_project_path(@project) ] ] %>

<div class="card card-body mb-6 flex flex-wrap items-center justify-between gap-3">
  <span class="text-sm font-medium text-fg"><%= @project.client.name %> 嘅測試結果</span>
  <%= render "shared/round_counts", round: @round %>
</div>

<% if @round.all_answered? && !@round.all_passed? %>
  <section class="card mb-6" aria-labelledby="ai-heading">
    <div class="card-header">
      <h2 id="ai-heading" class="section-title">AI 摘要</h2>
      <%= button_to (@round.ai_summary ? "重新摘要" : "用 AI 摘要同分類"), summarise_admin_project_uat_round_path(@project, @round), class: "btn btn-secondary btn-sm" %>
    </div>
    <div class="card-body">
      <% if (summary = @round.ai_summary) %>
        <p class="text-sm text-fg"><%= summary["overall"] %></p>
        <ul class="mt-4 space-y-3">
          <% summary["items"].each do |item| %>
            <li class="text-sm">
              <div class="flex flex-wrap items-center gap-2">
                <span class="code-chip"><%= item["code"] %></span>
                <%= ai_category_badge(item["category"]) %>
                <span class="text-fg"><%= item["summary"] %></span>
              </div>
              <p class="mt-1 text-xs text-fg-subtle"><%= item["reason"] %></p>
            </li>
          <% end %>
        </ul>
        <% if summary["items"].any? { |i| i["category"] == "change_request" } %>
          <%= callout(:violet, css: "mt-4") do %>有啲似係改需求，可能要 <%= link_to "開 CR", new_admin_project_change_request_path(@project), class: "font-medium underline" %>。<% end %>
        <% end %>
        <p class="mt-4 text-xs text-fg-subtle">AI 分類只供參考，<%= local_time(@round.ai_summarised_at) %> 產生</p>
      <% else %>
        <p class="text-sm text-fg-subtle">將唔 pass 嘅 comment 交畀 AI，分出邊啲係 bug、邊啲似改需求。</p>
      <% end %>
    </div>
  </section>
<% end %>

<ul class="list">
  <% @round.test_results.each do |r| %>
    <li class="px-4 py-4 sm:px-5">
      <div class="flex items-start justify-between gap-3">
        <p class="flex items-baseline gap-2"><span class="code-chip shrink-0"><%= r.test_case.code %></span><span class="font-medium text-fg"><%= r.test_case.title %></span></p>
        <%= result_badge(r) %>
      </div>
      <% if r.comment.present? %><p class="prose-text mt-3 rounded-lg bg-subtle px-3 py-2"><%= r.comment %></p><% end %>
      <% if r.screenshots.attached? %>
        <%= render "shared/screenshots", attachments: r.screenshots, alt: r.test_case.code %>
      <% end %>
    </li>
  <% end %>
</ul>
