<%# locals: (plan:, client:) -%>
<%= form_with model: plan, url: admin_client_retainer_plan_path(client), method: (plan.persisted? ? :patch : :post), scope: :retainer_plan,
      class: "card card-body max-w-2xl space-y-4" do |f| %>
  <%= render "shared/errors", record: plan %>
  <div class="grid gap-4 sm:grid-cols-2">
    <%= f.field :monthly_fee_hkd, "月費" do %>
      <div class="input-group"><span class="input-addon">HK$</span><%= f.number_field :monthly_fee_hkd, min: 0, step: 100 %></div>
    <% end %>
    <%= f.field :starts_on, "開始日" do %><%= f.date_field :starts_on %><% end %>
    <%= f.field :included_rounds, "每月包幾多輪修改" do %><%= f.number_field :included_rounds, min: 0 %><% end %>
    <%= f.field :extra_round_hkd, "超出每輪" do %>
      <div class="input-group"><span class="input-addon">HK$</span><%= f.number_field :extra_round_hkd, min: 0, step: 50 %></div>
    <% end %>
    <%= f.field :notice_days, "通知期（日）" do %><%= f.number_field :notice_days, min: 1 %><% end %>
    <%= f.field :quote_ref, "報價單編號", optional: true do %><%= f.text_field :quote_ref, class: "font-mono", placeholder: "QUO-XXX-001" %><% end %>
  </div>
  <%= callout(:info) do %>一張「修改」ticket 計一輪；「系統故障」唔計。用晒每月輪數之後，客要喺 portal 剔確認先開到下一張修改。<% end %>
  <div class="flex gap-2 pt-2">
    <%= f.submit "儲存" %>
    <%= link_to "取消", admin_client_path(client), class: "btn btn-ghost" %>
  </div>
<% end %>
