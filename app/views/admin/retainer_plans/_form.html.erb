<%= form_with model: plan, url: admin_client_retainer_plan_path(client), method: (plan.persisted? ? :patch : :post), scope: :retainer_plan, class: "space-y-4 max-w-lg bg-white rounded-xl border border-slate-200 p-6" do |f| %>
  <%= render "shared/errors", record: plan %>
  <div class="grid grid-cols-2 gap-4">
    <div><%= f.label :monthly_fee_hkd, "月費（HK$）", class: "block text-sm mb-1" %><%= f.number_field :monthly_fee_hkd, min: 0, step: 100, class: "w-full rounded-lg border-slate-300" %></div>
    <div><%= f.label :starts_on, "開始日", class: "block text-sm mb-1" %><%= f.date_field :starts_on, class: "w-full rounded-lg border-slate-300" %></div>
    <div><%= f.label :included_rounds, "每月包幾多輪修改", class: "block text-sm mb-1" %><%= f.number_field :included_rounds, min: 0, class: "w-full rounded-lg border-slate-300" %></div>
    <div><%= f.label :extra_round_hkd, "超出每輪（HK$）", class: "block text-sm mb-1" %><%= f.number_field :extra_round_hkd, min: 0, step: 50, class: "w-full rounded-lg border-slate-300" %></div>
    <div><%= f.label :notice_days, "通知期（日）", class: "block text-sm mb-1" %><%= f.number_field :notice_days, min: 1, class: "w-full rounded-lg border-slate-300" %></div>
    <div><%= f.label :quote_ref, "報價單編號（可選）", class: "block text-sm mb-1" %><%= f.text_field :quote_ref, class: "w-full rounded-lg border-slate-300 font-mono", placeholder: "QUO-XXX-001" %></div>
  </div>
  <p class="text-xs text-slate-500">一張「修改」ticket 計一輪；「系統故障」唔計。用晒每月輪數之後，客要喺 portal 剔確認先開到下一張修改。</p>
  <%= f.submit "儲存", class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm text-white hover:bg-indigo-700 cursor-pointer" %>
<% end %>
