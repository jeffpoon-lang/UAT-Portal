<%= page_header "Sign-off 記錄", subtitle: "所有 sign-off 串成一條 hash chain，撳驗證會用 Rust 由頭驗到尾。" do %>
  <%= button_to verify_admin_sign_offs_path, class: "btn btn-primary" do %><%= icon("shield-check") %>驗證成條 chain<% end %>
<% end %>

<% if @sign_offs.empty? %>
  <%= empty_state("未有 sign-off", icon: "file-check-2", body: "客戶喺 portal 簽署 UAT 之後，記錄會喺度出現。") %>
<% else %>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>編號</th><th>Project</th><th>簽署人</th><th>時間</th><th>Digest</th></tr></thead>
      <tbody>
        <% @sign_offs.each do |s| %>
          <tr>
            <td class="whitespace-nowrap"><%= link_to s.doc_number, admin_sign_off_path(s), class: "link font-mono text-xs" %></td>
            <td class="min-w-40"><span class="font-medium"><%= s.project.name %></span><span class="block text-xs text-fg-subtle"><%= s.project.client.name %></span></td>
            <td><%= s.signer_name %></td>
            <td class="whitespace-nowrap text-fg-muted"><%= local_time(s.signed_at) %></td>
            <td class="font-mono text-xs text-fg-subtle"><%= s.short_digest %>…</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
