<%= page_header "Retention", subtitle: "已上線客戶嘅月費維護用量，同邊個要主動跟進" do %>
  <div class="stat py-2 text-right">
    <p class="stat-label">生效中月費總和</p>
    <p class="text-xl font-semibold tracking-tight text-fg tabular"><%= hkd(@mrr) %></p>
  </div>
<% end %>

<% if @rows.empty? %>
  <%= empty_state("未有已上線或者有 retainer 嘅客戶") %>
<% else %>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr><th>客戶</th><th class="text-right">月費</th><th class="text-right">本月修改</th><th class="text-right">近 3 個月有超出</th><th>最後一張 ticket</th><th>訊號</th></tr>
      </thead>
      <tbody>
        <% @rows.each do |row| %>
          <% plan = row.plan %>
          <tr>
            <td class="min-w-32 font-medium"><%= link_to row.client.name, admin_client_path(row.client), class: "text-fg hover:text-accent" %></td>
            <td class="text-right whitespace-nowrap"><%= plan ? hkd(plan.monthly_fee_hkd) : "—" %></td>
            <td class="text-right whitespace-nowrap"><%= plan ? "#{row.rounds_used}／#{plan.included_rounds}" : "—" %></td>
            <td class="text-right whitespace-nowrap"><%= plan ? "#{row.months_with_extra} 個月" : "—" %></td>
            <td class="whitespace-nowrap text-fg-muted"><%= (t = row.last_ticket_at) ? "#{(@today - t.to_date).to_i} 日前" : "未有" %></td>
            <td class="whitespace-nowrap">
              <%= badge(row.signal_label, row.signal_tone) %>
              <% if row.signal == :notice %><span class="ml-1 text-xs text-fg-subtle"><%= plan.ends_on %> 完結</span><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="mt-3 text-xs text-fg-subtle">「用量偏低」：簽咗 60 日以上，但最近 60 日冇開過修改 ticket。「經常超出」：近 3 個月有 2 個月或以上要收額外輪數。</p>
<% end %>
