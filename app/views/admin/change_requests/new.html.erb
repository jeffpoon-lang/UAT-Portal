<%= page_header "新 Change Request", subtitle: "已用 #{@project.uat_rounds.size}／#{@project.allowed_uat_rounds} 個 UAT round",
      crumbs: [ [ "Projects", admin_projects_path ], [ @project.name, admin_project_path(@project) ] ] %>

<%= form_with model: [ :admin, @project, @change_request ], class: "card card-body max-w-xl space-y-4" do |f| %>
  <%= render "shared/errors", record: @change_request %>
  <%= f.field :description, "改咩／點解要加" do %><%= f.text_area :description, rows: 4 %><% end %>
  <div class="grid gap-4 sm:grid-cols-2">
    <%= f.field :extra_rounds, "加幾多個 UAT round" do %><%= f.number_field :extra_rounds, min: 0 %><% end %>
    <%= f.field :quote_hkd, "補充報價", optional: true do %>
      <div class="input-group"><span class="input-addon">HK$</span><%= f.number_field :quote_hkd, min: 0 %></div>
    <% end %>
  </div>
  <%= callout(:info) do %>SOP：客簽咗 CR 表先做；簽咗之後喺 project 頁撳「批核」，額外 round 先會生效。<% end %>
  <div class="flex gap-2 pt-2">
    <%= f.submit "建立 CR" %>
    <%= link_to "取消", admin_project_path(@project), class: "btn btn-ghost" %>
  </div>
<% end %>
