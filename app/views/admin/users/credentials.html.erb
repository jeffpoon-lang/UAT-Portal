<%# locals: (user:, client:, password:, created:) -%>
<% login_url = new_session_url %>
<% message = [
     "你好，UAT Portal 帳戶#{created ? "已經開好" : "嘅密碼已經重設"}：",
     "網址：#{login_url}",
     "電郵：#{user.email_address}",
     "密碼：#{password}",
     "登入之後可以喺右上角帳戶選單「改密碼」設定你自己嘅密碼。"
   ].join("\n") %>

<% title = created ? "帳戶已建立" : "密碼已重設" %>
<%= page_header title, subtitle: client.name,
      crumbs: [ [ "客戶", admin_clients_path ], [ client.name, admin_client_path(client) ] ] %>

<div class="max-w-xl space-y-6">
  <%= callout(:warning, role: "alert") do %>
    <p class="font-medium">密碼只會喺呢度顯示一次。</p>
    <p class="mt-0.5">離開或者重新整理呢頁之後就睇唔返，到時要再重設。</p>
  <% end %>

  <div class="card">
    <dl class="divide-y divide-line text-sm">
      <div class="flex items-center justify-between gap-3 px-4 py-3 sm:px-5">
        <dt class="text-fg-subtle">登入網址</dt>
        <dd class="truncate font-medium text-fg"><%= login_url %></dd>
      </div>
      <div class="flex items-center justify-between gap-3 px-4 py-3 sm:px-5">
        <dt class="text-fg-subtle">電郵</dt>
        <dd class="truncate font-medium text-fg"><%= user.email_address %></dd>
      </div>
      <div class="flex items-center justify-between gap-3 px-4 py-3 sm:px-5" data-controller="clipboard">
        <dt class="text-fg-subtle">密碼</dt>
        <dd class="flex items-center gap-2">
          <code id="new-password" class="rounded-md bg-subtle px-2 py-1 font-mono text-base font-semibold tracking-wide text-fg" data-clipboard-target="source"><%= password %></code>
          <button type="button" class="btn btn-secondary btn-sm" data-action="clipboard#copy"><span data-clipboard-target="label">複製</span></button>
        </dd>
      </div>
    </dl>
  </div>

  <section class="card" aria-labelledby="message-heading" data-controller="clipboard">
    <div class="card-header">
      <h2 id="message-heading" class="section-title">WhatsApp／email 訊息</h2>
      <button type="button" class="btn btn-primary btn-sm" data-action="clipboard#copy"><span data-clipboard-target="label">複製訊息</span></button>
    </div>
    <div class="card-body">
      <label for="credentials-message" class="sr-only">訊息內容</label>
      <textarea id="credentials-message" class="textarea font-mono text-sm" rows="6" readonly data-clipboard-target="source"><%= message %></textarea>
    </div>
  </section>

  <%= link_to admin_client_path(client), class: "btn btn-secondary" do %><%= icon("arrow-left") %>返去 <%= client.name %><% end %>
</div>
