<% content_for :title, @ticket.doc_number %>
<% subtitle = capture do %><span class="code-chip"><%= @ticket.doc_number %></span> <span class="ml-1"><%= @ticket.project.client.name %></span><% end %>
<%= page_header @ticket.title, subtitle: subtitle, crumbs: [ [ "Tickets", admin_tickets_path ] ] %>

<div class="grid gap-8 lg:grid-cols-3">
  <div class="lg:col-span-2">
    <%= render "shared/ticket_detail", ticket: @ticket %>
  </div>

  <div class="space-y-6">
    <%= form_with model: [ :admin, @ticket, @log ], url: admin_ticket_logs_path(@ticket), class: "card" do |f| %>
      <div class="card-header"><h2 class="section-title">記錄處理</h2></div>
      <div class="card-body space-y-4">
        <%= render "shared/errors", record: @log %>
        <div class="grid grid-cols-2 gap-3">
          <%= f.field :logged_on, "日期" do %><%= f.date_field :logged_on %><% end %>
          <%= f.field :minutes, "分鐘" do %><%= f.number_field :minutes, min: 0, step: 5 %><% end %>
        </div>
        <%= f.field :note, "做咗咩", hint: "客戶睇得到" do %><%= f.text_area :note, rows: 3 %><% end %>
        <%= f.submit "加記錄" %>
      </div>
    <% end %>

    <%= form_with model: [ :admin, @ticket ], method: :patch, class: "card" do |f| %>
      <div class="card-header"><h2 class="section-title">狀態</h2></div>
      <div class="card-body space-y-4">
        <%= f.field :status, "狀態" do %><%= f.select :status, Ticket::STATUS_LABELS.map { |k, v| [ v, k ] } %><% end %>
        <%= f.field :kind, "類別", hint: "改做「系統故障」唔計 retainer 輪數，亦唔收額外費用" do %><%= f.select :kind, Ticket::KIND_LABELS.map { |k, v| [ v, k ] } %><% end %>
        <%= f.field :priority, "優先度" do %><%= f.select :priority, Ticket::PRIORITY_LABELS.map { |k, v| [ v, k ] } %><% end %>
        <%= f.submit "更新", class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
