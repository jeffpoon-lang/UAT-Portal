<%= page_header "Maintenance tickets" do %>
  <%= link_to admin_maintenance_report_path, class: "btn btn-secondary" do %><%= icon("file-text") %>月尾報告<% end %>
<% end %>

<nav class="segmented mb-4" aria-label="篩選">
  <% Admin::TicketsController::FILTERS.each do |key, label| %>
    <%= link_to label, admin_tickets_path(filter: key), "aria-current": (@filter == key ? "page" : nil) %>
  <% end %>
</nav>

<% if @tickets.empty? %>
  <%= empty_state("冇 ticket", body: "客戶喺 portal 報問題之後會喺度出現。") %>
<% else %>
  <div class="list">
    <% @tickets.each do |t| %>
      <%= render "shared/ticket_row", ticket: t, href: admin_ticket_path(t), show_client: true %>
    <% end %>
  </div>
<% end %>
