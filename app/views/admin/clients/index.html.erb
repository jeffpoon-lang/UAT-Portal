<%= page_header "客戶" do %>
  <%= link_to new_admin_client_path, class: "btn btn-primary" do %><%= icon("plus") %>新客戶<% end %>
<% end %>

<% if @clients.empty? %>
  <%= empty_state("未有客戶", icon: "users", body: "加咗客戶之後就可以開 project 同設定月費維護。") do %>
    <%= link_to new_admin_client_path, class: "btn btn-primary" do %><%= icon("plus") %>新客戶<% end %>
  <% end %>
<% else %>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>客戶</th><th>Code</th><th>Email</th><th class="text-right">Projects</th><th>月費維護</th></tr></thead>
      <tbody>
        <% @clients.each do |c| %>
          <tr>
            <td class="font-medium"><%= link_to c.name, admin_client_path(c), class: "text-fg hover:text-accent" %></td>
            <td><span class="code-chip"><%= c.code %></span></td>
            <td class="text-fg-muted"><%= c.contact_email %></td>
            <td class="text-right"><%= c.projects.size %></td>
            <td>
              <% if (plan = c.retainer_plan) %>
                <%= plan.notice_given? ? badge("通知終止中", :danger) : badge(hkd(plan.monthly_fee_hkd) + "／月", :success) %>
              <% else %>
                <span class="text-fg-subtle">—</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
