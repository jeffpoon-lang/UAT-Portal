<% subtitle = capture do %><span class="code-chip"><%= @client.code %></span> <span class="ml-1"><%= @client.contact_email %></span><% end %>
<%= page_header @client.name, subtitle: subtitle, crumbs: [ [ "客戶", admin_clients_path ] ] do %>
  <%= link_to edit_admin_client_path(@client), class: "btn btn-secondary" do %><%= icon("pencil") %>改資料<% end %>
  <%= link_to new_admin_project_path(client_id: @client.id), class: "btn btn-primary" do %><%= icon("plus") %>新 project<% end %>
<% end %>

<div class="grid gap-8 lg:grid-cols-5">
  <section class="lg:col-span-3" aria-labelledby="projects-heading">
    <h2 id="projects-heading" class="section-title mb-3">Projects</h2>
    <% if @projects.empty? %>
      <%= empty_state("未有 project", icon: "folder-kanban") do %>
        <%= link_to new_admin_project_path(client_id: @client.id), class: "btn btn-secondary" do %><%= icon("plus") %>新 project<% end %>
      <% end %>
    <% else %>
      <div class="space-y-4">
        <% @projects.each do |project| %>
          <%= render "shared/project_card", project: project, href: admin_project_path(project) %>
        <% end %>
      </div>
    <% end %>
  </section>

  <div class="space-y-6 lg:col-span-2">
    <%= render "retainer", client: @client, plan: @client.retainer_plan %>
    <%= render "logins", client: @client %>
  </div>
</div>
