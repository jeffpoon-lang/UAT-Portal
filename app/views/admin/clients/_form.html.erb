<%# locals: (client:) -%>
<%= form_with model: [ :admin, client ], class: "card card-body max-w-xl space-y-4" do |f| %>
  <%= render "shared/errors", record: client %>
  <%= f.field :name, "客戶名" do %><%= f.text_field :name, autocomplete: "organization" %><% end %>
  <%= f.field :code, "Code", hint: "用喺文件編號，例如 UAT-AHYU-001" do %><%= f.text_field :code, class: "max-w-48 font-mono uppercase" %><% end %>
  <%= f.field :contact_email, "聯絡 email" do %><%= f.email_field :contact_email %><% end %>
  <div class="flex gap-2 pt-2">
    <%= f.submit "儲存" %>
    <%= link_to "取消", client.persisted? ? admin_client_path(client) : admin_clients_path, class: "btn btn-ghost" %>
  </div>
<% end %>
