<% subtitle = capture do %>
  <%= link_to @project.client.name, admin_client_path(@project.client), class: "link" %>
  · UAT 包 <%= @project.max_uat_rounds %> round
  <% if @project.maintenance_start_on %> · Maintenance 由 <%= @project.maintenance_start_on.strftime("%Y-%m-%d") %> 起<% end %>
<% end %>
<%= page_header @project.name, subtitle: subtitle, crumbs: [ [ "Projects", admin_projects_path ] ] do %>
  <%= link_to edit_admin_project_path(@project), class: "btn btn-secondary" do %><%= icon("pencil") %>改 project<% end %>
<% end %>

<div class="card card-body mb-8"><%= render "shared/phase_progress", project: @project, full: true %></div>

<div class="grid gap-8 lg:grid-cols-3">
  <div class="space-y-8 lg:col-span-2">
    <section aria-labelledby="uat-heading">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <h2 id="uat-heading" class="section-title">UAT <span class="ml-1 text-sm font-normal text-fg-subtle tabular">已用 <%= @project.uat_rounds.size %>／<%= @project.allowed_uat_rounds %> round</span></h2>
        <% if (reason = @project.cannot_open_round_reason) %>
          <span class="text-sm text-fg-subtle"><%= reason %></span>
        <% else %>
          <%= button_to admin_project_uat_rounds_path(@project), class: "btn btn-primary btn-sm" do %><%= icon("plus") %>開 Round <%= @project.uat_rounds.size + 1 %><% end %>
        <% end %>
      </div>
      <% if @project.uat_rounds.empty? && @project.accepted_externally? %>
        <%= callout(:success) do %>UAT 已於 <%= @project.uat_accepted_on.strftime("%Y-%m-%d") %> 喺系統外簽署驗收，見下面嘅簽署記錄。<% end %>
      <% elsif @project.uat_rounds.empty? %>
        <%= empty_state("未開過 round", body: "加齊 test case 之後開 Round 1，客戶就可以喺 portal 開始測試。") %>
      <% else %>
        <div class="list">
          <% @project.uat_rounds.each do |r| %>
            <%= render "shared/round_row", round: r, href: admin_project_uat_round_path(@project, r), audience: :admin %>
          <% end %>
        </div>
      <% end %>
    </section>

    <section id="external-sign-offs" aria-labelledby="ext-heading">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <h2 id="ext-heading" class="section-title">系統外簽署記錄</h2>
        <%= link_to new_admin_project_external_sign_off_path(@project), class: "btn btn-secondary btn-sm" do %><%= icon("plus") %>加簽署記錄<% end %>
      </div>
      <% if @project.external_sign_offs.empty? %>
        <p class="rounded-xl border border-dashed border-line-strong px-4 py-6 text-center text-sm text-fg-subtle">UAT 喺 portal 以外簽（例如紙本或者 PDF）就喺度記錄，客戶喺 portal 都睇到。</p>
      <% else %>
        <%= render "shared/external_sign_offs", project: @project, sign_offs: @project.external_sign_offs, audience: :admin %>
      <% end %>
    </section>

    <section aria-labelledby="cases-heading">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <h2 id="cases-heading" class="section-title">Test cases <span class="ml-1 text-sm font-normal text-fg-subtle tabular"><%= @project.test_cases.size %> 條</span></h2>
        <%= link_to new_admin_project_test_case_path(@project), class: "btn btn-secondary btn-sm" do %><%= icon("plus") %>加 test case<% end %>
      </div>
      <% if @project.test_cases.empty? %>
        <%= empty_state("未有 test case", body: "SOP 要求客最少交 10 條。") %>
      <% else %>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>編號</th><th>標題</th><th>預期結果</th><th>來源</th><th><span class="sr-only">操作</span></th></tr></thead>
            <tbody>
              <% @project.test_cases.each do |tc| %>
                <tr>
                  <td><span class="code-chip"><%= tc.code %></span></td>
                  <td class="min-w-48 font-medium"><%= tc.title %></td>
                  <td class="min-w-48 whitespace-pre-line text-fg-muted"><%= tc.expected %></td>
                  <td><%= badge(tc.source.upcase, :neutral) %></td>
                  <td class="text-right whitespace-nowrap">
                    <%= link_to edit_admin_project_test_case_path(@project, tc), class: "btn btn-ghost btn-sm btn-icon", "aria-label": "改 #{tc.code}" do %><%= icon("pencil") %><% end %>
                    <%= button_to admin_project_test_case_path(@project, tc), method: :delete, form_class: "inline", class: "btn btn-ghost btn-sm btn-icon hover:text-red-700",
                          "aria-label": "刪 #{tc.code}", data: { turbo_confirm: "確定刪 #{tc.code}？" } do %><%= icon("trash-2") %><% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </section>
  </div>

  <aside class="space-y-8">
    <section id="system-links" aria-labelledby="system-heading">
      <div class="mb-3 flex items-center justify-between gap-3">
        <h2 id="system-heading" class="section-title">系統資料</h2>
        <%= link_to new_admin_project_system_link_path(@project), class: "btn btn-secondary btn-sm" do %><%= icon("plus") %>加連結<% end %>
      </div>
      <% links = SystemLink.grouped(@project.system_links) %>
      <% if links.empty? %>
        <p class="rounded-xl border border-dashed border-line-strong px-4 py-6 text-center text-sm text-fg-subtle">網址、帳戶喺邊個名下、手冊位置。客戶喺 portal「系統資料」頁睇到。</p>
      <% else %>
        <div class="list">
          <% links.each do |kind, group| %>
            <p class="eyebrow bg-subtle px-4 py-1.5"><%= SystemLink::KIND_LABELS.fetch(kind) %></p>
            <% group.each do |link| %>
              <div class="flex items-start gap-2 px-4 py-2.5">
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm font-medium text-fg"><%= link.label %></p>
                  <% if link.url %><p class="truncate font-mono text-xs text-fg-subtle"><%= link_to link.url, link.url, target: "_blank", rel: "noopener noreferrer", class: "hover:text-accent" %></p><% end %>
                  <% if link.account_owner.present? %><p class="truncate text-xs text-fg-muted">帳戶：<%= link.account_owner %></p><% end %>
                </div>
                <%= link_to edit_admin_project_system_link_path(@project, link), class: "btn btn-ghost btn-sm btn-icon", "aria-label": "改「#{link.label}」" do %><%= icon("pencil") %><% end %>
                <%= button_to admin_project_system_link_path(@project, link), method: :delete, form_class: "inline", class: "btn btn-ghost btn-sm btn-icon hover:text-red-700",
                      "aria-label": "刪「#{link.label}」", data: { turbo_confirm: "確定刪「#{link.label}」？" } do %><%= icon("trash-2") %><% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
        <%= link_to "客戶睇到嘅版本", portal_project_system_path(@project), class: "link" %>
        <%= link_to (@project.support_notes.present? ? "改支援資料" : "加支援資料"), edit_admin_project_path(@project, anchor: "project_support_notes"), class: "link" %>
      </p>
    </section>

    <section aria-labelledby="change-requests">
    <div class="mb-3 flex items-center justify-between gap-3">
      <h2 id="change-requests" class="section-title">Change requests</h2>
      <%= link_to new_admin_project_change_request_path(@project), class: "btn btn-secondary btn-sm" do %><%= icon("plus") %>開 CR<% end %>
    </div>
    <% if @project.change_requests.empty? %>
      <p class="rounded-xl border border-dashed border-line-strong px-4 py-6 text-center text-sm text-fg-subtle">冇 CR。超出 round 數或者改需求先要開。</p>
    <% else %>
      <ul class="list">
        <% @project.change_requests.each do |cr| %>
          <li class="px-4 py-3">
            <div class="flex flex-wrap items-center gap-2">
              <span class="code-chip"><%= cr.doc_number %></span>
              <%= badge({ "pending" => "待批", "approved" => "已批核", "rejected" => "已拒絕" }[cr.status], UiHelper::CR_TONES.fetch(cr.status)) %>
            </div>
            <p class="mt-2 text-sm text-fg"><%= cr.description %></p>
            <p class="mt-1 text-xs text-fg-subtle tabular">+<%= cr.extra_rounds %> round<% if cr.quote_hkd %> · <%= hkd(cr.quote_hkd) %><% end %></p>
            <% if cr.status_pending? %>
              <div class="mt-3 flex gap-2">
                <%= button_to approve_admin_project_change_request_path(@project, cr), class: "btn btn-success btn-sm" do %><%= icon("check") %>批核<% end %>
                <%= button_to "拒絕", reject_admin_project_change_request_path(@project, cr), class: "btn btn-secondary btn-sm" %>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
    </section>
  </aside>
</div>
