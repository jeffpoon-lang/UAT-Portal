<%= page_header "Projects" do %>
  <%= link_to new_admin_project_path, class: "btn btn-primary" do %><%= icon("plus") %>新 project<% end %>
<% end %>

<% if @projects.empty? %>
  <%= empty_state("未有 project", body: "先加客戶，再開 project。") do %>
    <%= link_to new_admin_project_path, class: "btn btn-primary" do %><%= icon("plus") %>新 project<% end %>
  <% end %>
<% else %>
  <div class="grid gap-4 md:grid-cols-2">
    <% @projects.each do |project| %>
      <%= render "shared/project_card", project: project, href: admin_project_path(project), show_client: true %>
    <% end %>
  </div>
<% end %>
