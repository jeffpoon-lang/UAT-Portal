<%= page_header "改密碼", subtitle: Current.user.email_address %>

<%= form_with scope: :password_change, url: password_change_path, method: :patch, class: "card card-body max-w-md space-y-4" do |f| %>
  <% if @error %>
    <%= callout(:danger, role: "alert") do %><%= @error %><% end %>
  <% end %>
  <div class="field">
    <%= f.label :current_password, "現有密碼", class: "label" %>
    <%= f.password_field :current_password, required: true, autocomplete: "current-password", maxlength: 72 %>
  </div>
  <div class="field">
    <%= f.label :password, "新密碼", class: "label" %>
    <%= f.password_field :password, required: true, autocomplete: "new-password", minlength: User::MIN_PASSWORD_LENGTH, maxlength: 72 %>
    <p class="hint">最少 <%= User::MIN_PASSWORD_LENGTH %> 個字。改完之後，你喺其他裝置要用新密碼重新登入。</p>
  </div>
  <div class="field">
    <%= f.label :password_confirmation, "再輸入一次新密碼", class: "label" %>
    <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>
  <div class="pt-2"><%= f.submit "更新密碼" %></div>
<% end %>
