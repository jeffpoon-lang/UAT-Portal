<% content_for :title, "忘記密碼" %>
<h1 class="text-xl font-semibold tracking-tight text-fg">忘記密碼</h1>
<p class="mt-1 text-sm text-fg-muted">輸入登入用嘅電郵，我哋會寄重設連結畀你。</p>

<%= form_with url: passwords_path, class: "mt-6 space-y-4" do |form| %>
  <div class="field">
    <%= form.label :email_address, "電郵地址", class: "label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
  </div>
  <%= form.submit "寄重設連結", class: "btn btn-primary btn-lg w-full" %>
<% end %>

<%= callout(:info, css: "mt-6") do %>收唔到 email？請直接聯絡你嘅開發者重設密碼。<% end %>
<p class="mt-6 text-center text-sm"><%= link_to "返回登入", new_session_path, class: "link" %></p>
