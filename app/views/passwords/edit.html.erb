<% content_for :title, "設定新密碼" %>
<h1 class="text-xl font-semibold tracking-tight text-fg">設定新密碼</h1>
<p class="mt-1 text-sm text-fg-muted">改好之後要用新密碼重新登入。</p>

<%= form_with url: password_path(params[:token]), method: :put, class: "mt-6 space-y-4" do |form| %>
  <div class="field">
    <%= form.label :password, "新密碼", class: "label" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: User::MIN_PASSWORD_LENGTH, maxlength: 72 %>
    <p class="hint">最少 <%= User::MIN_PASSWORD_LENGTH %> 個字</p>
  </div>
  <div class="field">
    <%= form.label :password_confirmation, "再輸入一次", class: "label" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>
  <%= form.submit "儲存新密碼", class: "btn btn-primary btn-lg w-full" %>
<% end %>
