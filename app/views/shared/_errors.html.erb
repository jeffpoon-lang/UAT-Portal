<%# locals: (record:) -%>
<% if record.errors.any? %>
  <%= callout(:danger, css: "mb-5", role: "alert") do %>
    <p class="font-medium">有 <%= record.errors.count %> 個地方要改：</p>
    <ul class="mt-1 list-disc space-y-0.5 pl-5">
      <% record.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
    </ul>
  <% end %>
<% end %>
