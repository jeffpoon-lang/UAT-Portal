<% colors = { "pending" => "bg-slate-100 text-slate-600", "pass" => "bg-emerald-100 text-emerald-800",
              "fail" => "bg-red-100 text-red-800", "blocked" => "bg-amber-100 text-amber-800" } %>
<span class="inline-block rounded-full px-2 py-0.5 text-xs font-medium <%= colors.fetch(result.status) %>"><%= result.status_label %></span>
