<%# locals: (round:, href:, audience:) -%>
<%= link_to href, class: "list-row" do %>
  <span class="font-medium text-fg">Round <%= round.number %></span>
  <%= round_status_badge(round, audience) %>
  <% if round.sign_off %><span class="code-chip"><%= round.sign_off.doc_number %></span><% end %>
  <span class="ml-auto flex items-center gap-3">
    <%= render "shared/round_counts", round: round %>
    <%= icon("chevron-right", class: "size-4 text-fg-subtle") %>
  </span>
<% end %>
