<%# locals: (sign_off:) -%>
<% p = sign_off.payload %>
<article class="sheet">
  <header class="flex flex-wrap items-start justify-between gap-4 border-b border-line pb-6">
    <div>
      <p class="eyebrow">UAT Sign-off 驗收證書</p>
      <h1 class="mt-1.5 font-mono text-2xl font-semibold tracking-tight text-fg"><%= sign_off.doc_number %></h1>
    </div>
    <div class="sm:text-right">
      <%= badge("已鎖定", :success, icon: "shield-check") %>
      <p class="mt-2 text-sm text-fg-muted"><%= local_time(sign_off.signed_at, :zone) %></p>
    </div>
  </header>

  <dl class="grid grid-cols-1 gap-x-8 gap-y-4 py-6 text-sm sm:grid-cols-2">
    <div><dt class="text-xs text-fg-subtle">客戶</dt><dd class="mt-0.5 font-medium text-fg"><%= p.dig("client", "name") %></dd></div>
    <div><dt class="text-xs text-fg-subtle">Project</dt><dd class="mt-0.5 font-medium text-fg"><%= p.dig("project", "name") %></dd></div>
    <div><dt class="text-xs text-fg-subtle">簽署人</dt><dd class="mt-0.5 font-medium text-fg"><%= p.dig("signer", "name") %> <span class="font-normal text-fg-muted">（<%= p.dig("signer", "email") %>）</span></dd></div>
    <div><dt class="text-xs text-fg-subtle">UAT round</dt><dd class="mt-0.5 font-medium text-fg">Round <%= p["round"] %></dd></div>
  </dl>

  <table class="table table-compact">
    <thead><tr><th>編號</th><th>Test case</th><th class="text-right">結果</th></tr></thead>
    <tbody>
      <% p["results"].each do |r| %>
        <tr>
          <td class="font-mono text-xs whitespace-nowrap text-fg-muted"><%= r["code"] %></td>
          <td><%= r["title"] %></td>
          <td class="text-right"><%= badge(TestResult::STATUS_LABELS.fetch(r["status"], r["status"]), UiHelper::RESULT_TONES.fetch(r["status"], :neutral)) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="mt-8 rounded-lg bg-subtle p-4 text-xs text-fg-muted">
    <p class="flex flex-wrap gap-x-2"><span class="font-medium text-fg">Digest</span><span class="font-mono break-all"><%= sign_off.digest %></span></p>
    <p class="mt-1 flex flex-wrap gap-x-2"><span class="font-medium text-fg">上一條</span><span class="font-mono break-all"><%= sign_off.prev_digest %></span></p>
    <p class="mt-3 leading-relaxed">以上內容喺簽署當刻用 SHA-256 鎖定，並同之前所有 sign-off 串成一條 chain；之後任何修改都會被驗證工具發現。</p>
  </div>
</article>
