<%# 七個交付階段。full: true 會喺 desktop 顯示每個階段個名 %>
<%# locals: (project:, full: false) -%>
<% current = project.phase_index %>
<div>
  <div class="mb-2 flex items-center justify-between gap-2 text-xs">
    <span class="font-medium text-fg"><%= project.phase_label %></span>
    <span class="text-fg-subtle tabular">第 <%= current + 1 %>／<%= Project::PHASES.size %> 步</span>
  </div>
  <ol class="grid grid-cols-7 gap-1" aria-label="交付階段">
    <% Project::PHASES.each_with_index do |phase, i| %>
      <% state = i < current ? "已完成" : (i == current ? "而家" : "未到") %>
      <%= tag.li(aria: { current: (i == current ? "step" : nil) }) do %>
        <span class="block h-1.5 rounded-full <%= i <= current ? "bg-accent" : "bg-line" %>"></span>
        <% if full %>
          <span class="mt-2 hidden truncate text-[11px] sm:block <%= i == current ? "font-semibold text-accent" : "text-fg-subtle" %>" aria-hidden="true"><%= Project::PHASE_LABELS[phase] %></span>
        <% end %>
        <span class="sr-only"><%= Project::PHASE_LABELS[phase] %>（<%= state %>）</span>
      <% end %>
    <% end %>
  </ol>
</div>
