<%# locals: (ticket:) -%>
<article class="card">
  <div class="card-body">
    <div class="mb-3 flex flex-wrap gap-1.5"><%= ticket_badges(ticket) %></div>
    <p class="prose-text"><%= ticket.body %></p>
    <% if ticket.screenshots.attached? %>
      <%= render "shared/screenshots", attachments: ticket.screenshots, alt: ticket.doc_number %>
    <% end %>
  </div>
  <dl class="grid grid-cols-2 gap-4 border-t border-line px-4 py-3 text-xs sm:grid-cols-4 sm:px-5">
    <div><dt class="text-fg-subtle">Project</dt><dd class="mt-0.5 font-medium text-fg"><%= ticket.project.name %></dd></div>
    <div><dt class="text-fg-subtle">開單人</dt><dd class="mt-0.5 truncate font-medium text-fg" title="<%= ticket.opened_by.email_address %>"><%= ticket.opened_by.email_address %></dd></div>
    <div><dt class="text-fg-subtle">開單時間</dt><dd class="mt-0.5 font-medium text-fg"><%= local_time(ticket.created_at) %></dd></div>
    <div><dt class="text-fg-subtle">優先度</dt><dd class="mt-0.5 font-medium text-fg"><%= ticket.priority_label %></dd></div>
  </dl>
</article>

<% persisted_logs = ticket.logs.select(&:persisted?) %>
<section class="mt-8" aria-labelledby="logs-heading">
  <h2 id="logs-heading" class="section-title mb-4">
    處理記錄<% if persisted_logs.any? %><span class="ml-1 text-sm font-normal text-fg-subtle">（共 <%= ticket.total_minutes %> 分鐘）</span><% end %>
  </h2>
  <% if persisted_logs.empty? %>
    <p class="text-sm text-fg-subtle">未有記錄。</p>
  <% else %>
    <ol class="ml-1.5 space-y-5 border-l border-line">
      <% persisted_logs.each do |log| %>
        <li class="relative pl-5">
          <span class="absolute top-1.5 -left-[5px] size-2.5 rounded-full border-2 border-canvas bg-accent"></span>
          <p class="text-xs text-fg-subtle tabular"><%= log.logged_on.strftime("%Y-%m-%d") %> · <%= log.minutes %> 分鐘</p>
          <p class="prose-text mt-1"><%= log.note %></p>
        </li>
      <% end %>
    </ol>
  <% end %>
</section>
