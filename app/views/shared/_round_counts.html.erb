<%# locals: (round:) -%>
<% c = round.counts %>
<span class="inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-fg-muted tabular">
  <span class="inline-flex items-center gap-1.5"><span class="size-1.5 rounded-full bg-emerald-500"></span><%= c["pass"] %> pass</span>
  <span class="inline-flex items-center gap-1.5"><span class="size-1.5 rounded-full bg-red-500"></span><%= c["fail"] %> fail</span>
  <span class="inline-flex items-center gap-1.5"><span class="size-1.5 rounded-full bg-amber-500"></span><%= c["blocked"] %> 測唔到</span>
  <span class="inline-flex items-center gap-1.5"><span class="size-1.5 rounded-full bg-zinc-300"></span><%= c["pending"] %> 未測</span>
</span>
