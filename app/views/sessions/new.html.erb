<% content_for :title, "登入" %>
<h1 class="text-xl font-semibold tracking-tight text-fg">登入</h1>
<p class="mt-1 text-sm text-fg-muted">用你嘅電郵同密碼登入。</p>

<%= form_with url: session_url, class: "mt-6 space-y-4" do |form| %>
  <div class="field">
    <%= form.label :email_address, "電郵地址", class: "label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
  </div>
  <div class="field">
    <div class="flex items-baseline justify-between gap-2">
      <%= form.label :password, "密碼", class: "label" %>
      <%= link_to "忘記密碼？", new_password_path, class: "link text-xs" %>
    </div>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
  </div>
  <%= form.submit "登入", class: "btn btn-primary btn-lg w-full", data: { turbo_submits_with: "登入緊…" } %>
<% end %>
