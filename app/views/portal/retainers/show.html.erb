<% subtitle = capture do %><%= Current.user.client&.name %><% if @plan.quote_ref.present? %> <span class="code-chip ml-1"><%= @plan.quote_ref %></span><% end %><% end %>
<%= page_header "月費維護", subtitle: subtitle %>

<dl class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
  <div class="stat"><dt class="stat-label">月費</dt><dd class="stat-value text-lg sm:text-xl"><%= hkd(@plan.monthly_fee_hkd) %></dd></div>
  <div class="stat"><dt class="stat-label">每月包</dt><dd class="stat-value text-lg sm:text-xl"><%= @plan.included_rounds %> 輪修改</dd></div>
  <div class="stat"><dt class="stat-label">超出每輪</dt><dd class="stat-value text-lg sm:text-xl"><%= hkd(@plan.extra_round_hkd) %></dd></div>
  <div class="stat"><dt class="stat-label">通知期</dt><dd class="stat-value text-lg sm:text-xl"><%= @plan.notice_days %> 日</dd></div>
</dl>

<% if @plan.active_on?(@today) %>
  <div class="mb-8"><%= render "shared/retainer_usage", plan: @plan, today: @today %></div>
<% end %>

<% if @plan.notice_given? %>
  <%= callout(:danger, css: "mb-6") do %>
    <%= @plan.notice_by_label %>於 <%= @plan.notice_given_on %> 通知終止，合約 <strong><%= @plan.ends_on %></strong> 完結。請同我哋一齊完成以下交接；你負責嘅項目可以喺度直接剔選。
  <% end %>
  <%= render "shared/handover_items", plan: @plan, namespace: :portal %>
<% else %>
  <p class="text-sm text-fg-subtle">任何一方要終止，須提前 <%= @plan.notice_days %> 日以電郵書面通知；通知期內會一齊完成交接。</p>
<% end %>
