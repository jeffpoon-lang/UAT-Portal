<%= page_header "報問題／要求改動", crumbs: [ [ @project.name, portal_project_path(@project) ] ] %>

<%= form_with model: @ticket, url: portal_project_tickets_path(@project), class: "card card-body max-w-2xl space-y-5" do |f| %>
  <%= render "shared/errors", record: @ticket %>
  <% plan = @project.client.retainer_plan %>
  <% if plan&.active_on?(Date.current) %>
    <%= render "shared/retainer_usage", plan: plan, today: Date.current, framed: false %>
  <% end %>

  <%= f.choice_group :kind, [ [ "change", "要求改動" ], [ "fault", "系統故障（本來用得，而家壞咗）" ] ], legend: "類別",
        grid: "grid gap-2 sm:grid-cols-2", hint: ("系統故障唔計修改輪數。" if plan) %>
  <%= f.field :title, "一句講咩問題" do %><%= f.text_field :title, placeholder: "例如：報名表撳提交冇反應" %><% end %>
  <%= f.field :body, "詳細情況" do %><%= f.text_area :body, rows: 5, placeholder: "喺邊一頁、做咗咩、見到咩、幾時開始" %><% end %>
  <%= f.choice_group :priority, [ [ "low", "唔急" ], [ "normal", "一般" ], [ "urgent", "緊急（影響生意）" ] ], legend: "有幾急",
        grid: "grid grid-cols-3 gap-2" %>
  <%= f.field :screenshots, "截圖", optional: true, hint: "可以一次揀多張" do %><div><%= render "ui/upload_button", f: f %></div><% end %>

  <% if plan&.next_round_is_extra? %>
    <%= callout(:warning) do %>
      <p>本月 <%= plan.included_rounds %> 輪修改已經用晒。如果呢張係「要求改動」，會計做額外一輪，另收 <strong><%= hkd(plan.extra_round_hkd) %></strong>，喺下個月月費單一併結算。</p>
      <label class="mt-3 flex cursor-pointer items-start gap-2.5 font-medium">
        <%= f.check_box :confirm_extra_round, class: "mt-0.5" %>
        <span>我明白，確認開額外一輪</span>
      </label>
    <% end %>
  <% end %>

  <div class="pt-1"><%= f.submit "提交", class: "btn btn-primary btn-lg w-full sm:w-auto" %></div>
<% end %>
