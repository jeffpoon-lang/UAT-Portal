<%# root 嘅 id 俾 Portal::TestResultsController 嘅 turbo stream 用，唔好改 %>
<%# locals: (round:, project:) -%>
<div id="round-submit">
  <% if round.status_open? %>
    <section class="card" aria-labelledby="submit-heading">
      <div class="card-body">
        <h2 id="submit-heading" class="section-title">提交結果</h2>
        <% if !round.all_answered? %>
          <p class="mt-1 text-sm text-fg-muted">仲有 <%= round.counts["pending"] %> 條未剔，全部剔完先可以提交。</p>
        <% elsif round.all_passed? %>
          <% if Current.user.role_client? %>
            <%= form_with url: sign_off_portal_project_uat_round_path(project, round), method: :post, class: "mt-3 space-y-4", data: { turbo: false } do %>
              <%= callout(:success) do %>全部 pass，可以簽署驗收。<% end %>
              <div class="field">
                <label class="label" for="signer_name">簽署人全名</label>
                <input type="text" id="signer_name" name="signer_name" required autocomplete="name" class="input max-w-sm">
              </div>
              <label class="flex items-start gap-2.5 text-sm text-fg">
                <input type="checkbox" name="confirm" value="1" required class="checkbox mt-0.5">
                <span>我確認已完成以上所有測試，結果全部符合預期，同意驗收（UAT sign-off）。</span>
              </label>
              <button class="btn btn-success btn-lg w-full sm:w-auto"><%= icon("file-check-2") %>簽署 sign-off</button>
            <% end %>
          <% else %>
            <p class="mt-1 text-sm text-fg-muted">全部 pass，等客戶簽署。</p>
          <% end %>
        <% else %>
          <p class="mt-1 mb-4 text-sm text-fg-muted">有 <%= round.failing_results.size %> 條唔 pass，提交之後 IT 會修正再開下一個 round。</p>
          <%= button_to "提交，等 IT 修正", request_changes_portal_project_uat_round_path(project, round), data: { turbo: false }, class: "btn btn-primary btn-lg w-full sm:w-auto" %>
        <% end %>
      </div>
    </section>
  <% elsif round.status_signed_off? %>
    <%= callout(:success) do %>已簽署：<%= link_to round.sign_off.doc_number, portal_sign_off_path(round.sign_off), class: "font-medium underline" %><% end %>
  <% else %>
    <%= callout(:info) do %>呢個 round 已提交，等 IT 修正。<% end %>
  <% end %>
</div>
