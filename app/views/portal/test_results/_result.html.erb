<%= turbo_frame_tag dom_id(result) do %>
  <div class="rounded-xl bg-white border <%= result.errors.any? ? "border-red-300" : "border-slate-200" %> p-4">
    <div class="flex items-start justify-between gap-3 mb-2">
      <div>
        <span class="font-mono text-sm text-slate-500 mr-2"><%= result.test_case.code %></span>
        <span class="font-medium"><%= result.test_case.title %></span>
      </div>
      <%= render "shared/result_badge", result: result %>
    </div>
    <% if result.test_case.steps.present? %>
      <p class="text-sm text-slate-600 whitespace-pre-line mb-1"><span class="text-slate-500">步驟：</span><%= result.test_case.steps %></p>
    <% end %>
    <% if result.test_case.expected.present? %>
      <p class="text-sm text-slate-600 mb-3"><span class="text-slate-500">預期：</span><%= result.test_case.expected %></p>
    <% end %>

    <% if result.uat_round.status_open? %>
      <%= form_with model: result, url: portal_project_uat_round_test_result_path(result.uat_round.project, result.uat_round, result),
                    method: :patch, class: "space-y-3" do |f| %>
        <% if result.errors.any? %>
          <p class="text-sm text-red-700"><%= result.errors.full_messages.to_sentence %></p>
        <% end %>
        <fieldset class="flex flex-wrap gap-2">
          <legend class="sr-only">結果</legend>
          <% [ [ "pass", "Pass", "peer-checked:bg-emerald-600" ], [ "fail", "Fail", "peer-checked:bg-red-600" ], [ "blocked", "測唔到", "peer-checked:bg-amber-600" ] ].each do |value, label, color| %>
            <label class="cursor-pointer">
              <%= f.radio_button :status, value, class: "peer sr-only" %>
              <span class="block rounded-lg border border-slate-300 px-4 py-2 text-sm peer-checked:text-white peer-checked:border-transparent <%= color %> peer-focus-visible:ring-2 peer-focus-visible:ring-indigo-500"><%= label %></span>
            </label>
          <% end %>
        </fieldset>
        <%= f.text_area :comment, rows: 2, placeholder: "Fail 或者測唔到嘅話，寫低見到咩問題", class: "w-full rounded-lg border-slate-300 text-sm" %>
        <div class="flex flex-wrap items-center gap-3">
          <label class="text-sm text-slate-600">
            <span class="sr-only">上載截圖</span>
            <%= f.file_field :screenshots, multiple: true, accept: "image/*", class: "text-sm file:mr-2 file:rounded-lg file:border-0 file:bg-slate-100 file:px-3 file:py-2" %>
          </label>
          <%= f.submit "儲存", class: "ml-auto rounded-lg bg-indigo-600 px-4 py-2 text-sm text-white hover:bg-indigo-700 cursor-pointer" %>
        </div>
        <% if local_assigns[:saved] %><p class="text-xs text-emerald-700" role="status">已儲存</p><% end %>
      <% end %>
    <% elsif result.comment.present? %>
      <p class="text-sm text-slate-700 bg-slate-50 rounded-lg px-3 py-2"><%= result.comment %></p>
    <% end %>

    <% shots = result.screenshots.select(&:persisted?) %>
    <% if shots.any? %>
      <div class="flex flex-wrap gap-2 mt-3">
        <% shots.each do |shot| %>
          <%= link_to url_for(shot), target: "_blank", data: { turbo: false } do %>
            <%= image_tag url_for(shot), class: "h-20 w-auto rounded-md border border-slate-200", alt: "#{result.test_case.code} 截圖" %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
