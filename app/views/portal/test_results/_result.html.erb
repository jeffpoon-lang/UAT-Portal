<%# frame 嘅 id（dom_id）俾 Portal::TestResultsController 嘅 turbo stream 用，唔好改 %>
<%# locals: (result:, saved: false) -%>
<% tc = result.test_case %>
<%= turbo_frame_tag dom_id(result) do %>
  <article class="card <%= "border-red-300" if result.errors.any? %>">
    <div class="card-body">
      <div class="flex items-start justify-between gap-3">
        <h2 class="flex items-baseline gap-2"><span class="code-chip shrink-0"><%= tc.code %></span><span class="font-medium text-fg"><%= tc.title %></span></h2>
        <%= result_badge(result) %>
      </div>

      <% if tc.steps.present? || tc.expected.present? %>
        <dl class="mt-3 space-y-2 text-sm">
          <% if tc.steps.present? %><div><dt class="text-xs font-medium text-fg-subtle">步驟</dt><dd class="prose-text mt-0.5 text-fg-muted"><%= tc.steps %></dd></div><% end %>
          <% if tc.expected.present? %><div><dt class="text-xs font-medium text-fg-subtle">預期結果</dt><dd class="mt-0.5 text-fg-muted"><%= tc.expected %></dd></div><% end %>
        </dl>
      <% end %>
      <%= render "shared/it_check", test_case: tc %>

      <% if result.uat_round.status_open? %>
        <%= form_with model: result, url: portal_project_uat_round_test_result_path(result.uat_round.project, result.uat_round, result),
                      method: :patch, class: "mt-4 space-y-3 border-t border-line pt-4" do |f| %>
          <% if result.errors.any? %>
            <p class="field-error mt-0" role="alert"><%= result.errors.full_messages.to_sentence %></p>
          <% end %>
          <%= f.choice_group :status, [ [ "pass", "Pass" ], [ "fail", "Fail" ], [ "blocked", "測唔到" ] ], legend: "#{tc.code} 結果", legend_class: "sr-only",
                tones: { "pass" => "choice-pass", "fail" => "choice-fail", "blocked" => "choice-blocked" }, grid: "grid grid-cols-3 gap-2" %>
          <%= f.label :comment, "#{tc.code} 備註", class: "sr-only" %>
          <%= f.text_area :comment, rows: 2, placeholder: "Fail 或者測唔到嘅話，寫低見到咩問題" %>
          <div class="flex flex-wrap items-center gap-2">
            <%= render "ui/upload_button", f: f %>
            <% if saved %>
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-emerald-700" role="status"><%= icon("circle-check", class: "size-3.5") %>已儲存</span>
            <% end %>
            <%= f.submit "儲存", class: "btn btn-primary ml-auto", data: { turbo_submits_with: "儲存中…" } %>
          </div>
        <% end %>
      <% elsif result.comment.present? %>
        <p class="prose-text mt-3 rounded-lg bg-subtle px-3 py-2"><%= result.comment %></p>
      <% end %>

      <% shots = result.screenshots.select(&:persisted?) %>
      <% if shots.any? %>
        <%= render "shared/screenshots", attachments: shots, alt: tc.code, size: "h-20" %>
      <% end %>
    </div>
  </article>
<% end %>
