<% content_for :title, "我嘅 project" %>
<h1 class="text-2xl font-semibold mb-6">我嘅 project</h1>
<% if @projects.empty? %>
  <p class="text-slate-500">暫時未有 project。</p>
<% end %>
<div class="space-y-4">
  <% @projects.each do |project| %>
    <%= link_to portal_project_path(project), class: "block rounded-xl bg-white border border-slate-200 p-4 hover:border-indigo-300" do %>
      <div class="font-medium mb-3"><%= project.name %></div>
      <%= render "shared/phase_progress", project: project %>
    <% end %>
  <% end %>
</div>
