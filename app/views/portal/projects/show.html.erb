<% content_for :title, @project.name %>
<h1 class="text-2xl font-semibold mb-1"><%= @project.name %></h1>
<p class="text-sm text-slate-500 mb-6">而家階段：<strong><%= @project.phase_label %></strong></p>
<div class="mb-8"><%= render "shared/phase_progress", project: @project %></div>
<h2 class="text-lg font-semibold mb-3">Test cases</h2>
<ul class="space-y-2">
  <% @project.test_cases.each do |tc| %>
    <li class="rounded-lg bg-white border border-slate-200 px-4 py-3">
      <span class="font-mono text-sm text-slate-500 mr-2"><%= tc.code %></span><%= tc.title %>
      <% if tc.expected.present? %><p class="text-sm text-slate-600 mt-1">預期：<%= tc.expected %></p><% end %>
    </li>
  <% end %>
</ul>
