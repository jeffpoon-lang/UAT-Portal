<%# locals: (title:, subtitle: nil, crumbs: [], actions: nil) -%>
<header class="mb-6 flex flex-wrap items-end justify-between gap-x-4 gap-y-3 sm:mb-8">
  <div class="min-w-0">
    <% if crumbs.any? %>
      <nav class="breadcrumbs" aria-label="麵包屑">
        <% crumbs.each_with_index do |(label, path), i| %>
          <% if i.positive? %><%= icon("chevron-right") %><% end %>
          <%= link_to label, path %>
        <% end %>
      </nav>
    <% end %>
    <h1 class="page-title"><%= title %></h1>
    <% if subtitle.present? %><div class="page-subtitle"><%= subtitle %></div><% end %>
  </div>
  <% if actions.present? %>
    <div class="flex flex-wrap items-center gap-2"><%= actions %></div>
  <% end %>
</header>
